<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SkzZone</RootNamespace>
    <AssemblyName>SkzZone</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sürüm sabitlenmedi; en güncel kararlı sürümü çeker. Sorun çıkarsa
         sunucundaki CounterStrikeSharp sürümüyle aynı Version'ı yaz. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="*" />
  </ItemGroup>

</Project>
